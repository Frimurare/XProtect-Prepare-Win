<Application x:Class="XProtectPrepareWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UI/Theme.xaml"/>
                <!-- Default palette; ThemeManager swaps this for ThemeLight.xaml when Windows uses light apps mode. -->
                <ResourceDictionary Source="pack://application:,,,/UI/ThemeDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
