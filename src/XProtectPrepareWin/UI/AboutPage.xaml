<UserControl x:Class="XProtectPrepareWin.UI.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:XProtectPrepareWin.UI"
             Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,40,30,40" MaxWidth="620" HorizontalAlignment="Center">
            <Image Source="/Assets/wolf-smooth.png" Width="96" Height="96" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock Text="XProtect Prepare Win" FontSize="24" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock x:Name="VersionText" Text="Version" FontSize="13"
                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>

            <TextBlock Text="{l:Loc about.builtBy}"
                       FontSize="13.5" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,20,0,0"/>
            <TextBlock Text="{l:Loc about.tagline}"
                       FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <Image Source="/Assets/manvarg-white.png" Width="150" HorizontalAlignment="Center"
                   Opacity="0.85" Margin="0,26,0,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <Border Style="{StaticResource Card}" Margin="0,28,0,0" Padding="18,14">
                <TextBlock FontSize="12.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="{l:Loc about.disclaimer}"/>
            </Border>

            <TextBlock Text="{l:Loc about.license}" FontSize="12"
                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>

            <TextBlock HorizontalAlignment="Center" FontSize="13" Margin="0,8,0,0">
                <Hyperlink NavigateUri="https://github.com/Frimurare/XProtect-Prepare-Win"
                           RequestNavigate="GitHubLink_RequestNavigate"
                           Foreground="{DynamicResource AccentLightBrush}"
                           TextDecorations="None">github.com/Frimurare/XProtect-Prepare-Win</Hyperlink>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
