<UserControl x:Class="XProtectPrepareWin.UI.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Saved automatically. Applies to both the UI and silent runs."
                       Style="{StaticResource PageSub}" Margin="0,6,0,18"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Antivirus whole-drive exclusions" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Which drives get a whole-drive Windows Defender exclusion for recording storage."
                               Style="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap"/>

                    <RadioButton x:Name="DrivesStorageRadio" GroupName="DrivesSel"
                                 Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,4"
                                 Content="All storage drives (recommended)"
                                 Checked="DrivesRadio_Checked"/>
                    <TextBlock Text="Every non-OS drive is excluded - the normal choice for recording servers."
                               Style="{StaticResource MutedText}" Margin="20,0,0,8" TextWrapping="Wrap"/>

                    <RadioButton x:Name="DrivesNoneRadio" GroupName="DrivesSel"
                                 Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,4"
                                 Content="Only Milestone folders (no whole-drive)"
                                 Checked="DrivesRadio_Checked"/>
                    <TextBlock Text="Only the Milestone program and data folders are excluded."
                               Style="{StaticResource MutedText}" Margin="20,0,0,8" TextWrapping="Wrap"/>

                    <RadioButton x:Name="DrivesSpecificRadio" GroupName="DrivesSel"
                                 Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,4"
                                 Content="Specific drives:"
                                 Checked="DrivesRadio_Checked"/>
                    <TextBox x:Name="DrivesBox" Style="{StaticResource DarkTextBox}" Margin="20,6,0,2"
                             Width="220" HorizontalAlignment="Left" IsEnabled="False"
                             TextChanged="DrivesBox_TextChanged"/>
                    <TextBlock Text="Comma-separated drive letters, e.g. D,E"
                               Style="{StaticResource MutedText}" Margin="20,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Options" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>

                    <CheckBox x:Name="SshToggle" Style="{StaticResource SwitchToggle}" Margin="0,4,0,4"
                              Content="Include SSH server (optional task)"
                              Checked="SshToggle_Changed" Unchecked="SshToggle_Changed"/>
                    <TextBlock Text="Installs and enables OpenSSH Server for remote administration."
                               Style="{StaticResource MutedText}" Margin="50,0,0,12" TextWrapping="Wrap"/>

                    <CheckBox x:Name="SnmpToggle" Style="{StaticResource SwitchToggle}" Margin="0,4,0,4"
                              Content="Include SNMP (optional task)"
                              Checked="SnmpToggle_Changed" Unchecked="SnmpToggle_Changed"/>
                    <TextBlock Text="Installs the SNMP service for monitoring systems."
                               Style="{StaticResource MutedText}" Margin="50,0,0,12" TextWrapping="Wrap"/>

                    <CheckBox x:Name="RestartExplorerToggle" Style="{StaticResource SwitchToggle}" Margin="0,4,0,4"
                              Content="Restart Explorer after clock-seconds change"
                              Checked="RestartExplorerToggle_Changed" Unchecked="RestartExplorerToggle_Changed"/>
                    <TextBlock Text="Showing seconds in the system clock requires an Explorer restart to take effect immediately."
                               Style="{StaticResource MutedText}" Margin="50,0,0,4" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
