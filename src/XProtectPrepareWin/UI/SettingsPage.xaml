<UserControl x:Class="XProtectPrepareWin.UI.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:XProtectPrepareWin.UI"
             Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{l:Loc nav.settings}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:Loc settings.subtitle}"
                       Style="{StaticResource PageSub}" Margin="0,6,0,18"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:Loc settings.lang.title}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{l:Loc settings.lang.desc}"
                               Style="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                    <ComboBox x:Name="LanguageCombo" Width="340" HorizontalAlignment="Left"
                              FontSize="13" SelectionChanged="LanguageCombo_Changed"/>
                    <TextBlock x:Name="LanguageRestartHint" Text="{l:Loc settings.lang.restartHint}"
                               FontSize="12" Foreground="{DynamicResource AmberBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:Loc settings.av.title}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{l:Loc settings.av.desc}"
                               Style="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap"/>

                    <RadioButton x:Name="DrivesStorageRadio" GroupName="DrivesSel"
                                 Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,4"
                                 Content="{l:Loc settings.av.storage}"
                                 Checked="DrivesRadio_Checked"/>
                    <TextBlock Text="{l:Loc settings.av.storageDesc}"
                               Style="{StaticResource MutedText}" Margin="20,0,0,8" TextWrapping="Wrap"/>

                    <RadioButton x:Name="DrivesNoneRadio" GroupName="DrivesSel"
                                 Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,4"
                                 Content="{l:Loc settings.av.none}"
                                 Checked="DrivesRadio_Checked"/>
                    <TextBlock Text="{l:Loc settings.av.noneDesc}"
                               Style="{StaticResource MutedText}" Margin="20,0,0,8" TextWrapping="Wrap"/>

                    <RadioButton x:Name="DrivesSpecificRadio" GroupName="DrivesSel"
                                 Foreground="{DynamicResource TextBrush}" FontSize="13" Margin="0,4"
                                 Content="{l:Loc settings.av.specific}"
                                 Checked="DrivesRadio_Checked"/>
                    <TextBox x:Name="DrivesBox" Style="{StaticResource DarkTextBox}" Margin="20,6,0,2"
                             Width="220" HorizontalAlignment="Left" IsEnabled="False"
                             TextChanged="DrivesBox_TextChanged"/>
                    <TextBlock Text="{l:Loc settings.av.specificHint}"
                               Style="{StaticResource MutedText}" Margin="20,2,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:Loc settings.ntp.title}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{l:Loc settings.ntp.desc}"
                               Style="{StaticResource MutedText}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                    <ComboBox x:Name="NtpSourceCombo" Width="340" HorizontalAlignment="Left"
                              FontSize="13" SelectionChanged="NtpSourceCombo_Changed"/>
                    <TextBlock x:Name="NtpPeersPreview" Style="{StaticResource MutedText}"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Loc settings.options}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>

                    <CheckBox x:Name="SshToggle" Style="{StaticResource SwitchToggle}" Margin="0,4,0,4"
                              Content="{l:Loc settings.ssh}"
                              Checked="SshToggle_Changed" Unchecked="SshToggle_Changed"/>
                    <TextBlock Text="{l:Loc settings.sshDesc}"
                               Style="{StaticResource MutedText}" Margin="50,0,0,12" TextWrapping="Wrap"/>

                    <CheckBox x:Name="SnmpToggle" Style="{StaticResource SwitchToggle}" Margin="0,4,0,4"
                              Content="{l:Loc settings.snmp}"
                              Checked="SnmpToggle_Changed" Unchecked="SnmpToggle_Changed"/>
                    <TextBlock Text="{l:Loc settings.snmpDesc}"
                               Style="{StaticResource MutedText}" Margin="50,0,0,12" TextWrapping="Wrap"/>

                    <CheckBox x:Name="RestartExplorerToggle" Style="{StaticResource SwitchToggle}" Margin="0,4,0,4"
                              Content="{l:Loc settings.restartExplorer}"
                              Checked="RestartExplorerToggle_Changed" Unchecked="RestartExplorerToggle_Changed"/>
                    <TextBlock Text="{l:Loc settings.restartExplorerDesc}"
                               Style="{StaticResource MutedText}" Margin="50,0,0,4" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
