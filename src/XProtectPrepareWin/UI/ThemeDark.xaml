<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Dark palette (the original v1.0 look, unchanged) ============ -->
    <SolidColorBrush x:Key="BgBrush" Color="#0B0F1A"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0E1526"/>
    <SolidColorBrush x:Key="CardBrush" Color="#131B2E"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1E293F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2B6CEB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3D7BF0"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#5B8DEF"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#35C759"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#F5A623"/>
    <SolidColorBrush x:Key="RedBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="TealBrush" Color="#2EC4B6"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E8ECF4"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8A94AD"/>
    <SolidColorBrush x:Key="InputBrush" Color="#0F1524"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1A2438"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#262B6CEB"/>

    <!-- Control detail colors -->
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#D9313C"/>
    <SolidColorBrush x:Key="SubtleHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="CheckBorderBrush" Color="#3A465F"/>
    <SolidColorBrush x:Key="SwitchTrackBrush" Color="#2A3450"/>
    <SolidColorBrush x:Key="SwitchKnobBrush" Color="#8A94AD"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33405E"/>

    <!-- Status badge background tints -->
    <SolidColorBrush x:Key="GreyBgBrush" Color="#1A8A94AD"/>
    <SolidColorBrush x:Key="AccentBgBrush" Color="#1F2B6CEB"/>
    <SolidColorBrush x:Key="GreenBgBrush" Color="#2035C759"/>
    <SolidColorBrush x:Key="AmberBgBrush" Color="#20F5A623"/>
    <SolidColorBrush x:Key="RedBgBrush" Color="#20E5484D"/>
    <SolidColorBrush x:Key="TealBgBrush" Color="#202EC4B6"/>

</ResourceDictionary>
