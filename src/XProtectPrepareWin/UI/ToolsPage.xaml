<UserControl x:Class="XProtectPrepareWin.UI.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:XProtectPrepareWin.UI"
             Foreground="{DynamicResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,24" MaxWidth="1500">
            <TextBlock Text="{l:Loc nav.tools}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{l:Loc tools.subtitle}"
                       Style="{StaticResource PageSub}" Margin="0,6,0,18"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- NTP Recovery -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Loc tools.ntp.title}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{l:Loc tools.ntp.desc}"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Border x:Name="NtpBanner" Background="{DynamicResource GreyBgBrush}" CornerRadius="8" Padding="12,8"
                                Margin="0,0,0,12">
                            <TextBlock x:Name="NtpStatusText" Text="{l:Loc status.checking}" FontSize="12.5"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="NtpFixButton" Style="{StaticResource PrimaryButton}"
                                    Content="{l:Loc tools.ntp.apply}" IsEnabled="False" Click="NtpFixButton_Click"/>
                            <Button x:Name="NtpRecheckButton" Style="{StaticResource SecondaryButton}"
                                    Content="{l:Loc tools.ntp.recheck}" Margin="10,0,0,0" Click="NtpRecheckButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Windows Update -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Loc tools.wu.title}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{l:Loc tools.wu.desc}"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Border x:Name="WuBanner" Background="{DynamicResource GreyBgBrush}" CornerRadius="8" Padding="12,8"
                                Margin="0,0,0,12">
                            <TextBlock x:Name="WuStatusText" Text="{l:Loc status.checking}" FontSize="12.5"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="WuEnableButton" Style="{StaticResource SecondaryButton}"
                                    Content="{l:Loc tools.wu.enable}" IsEnabled="False" Click="WuEnableButton_Click"/>
                            <Button x:Name="WuDisableButton" Style="{StaticResource SecondaryButton}"
                                    Content="{l:Loc tools.wu.disable}" IsEnabled="False" Margin="10,0,0,0" Click="WuDisableButton_Click"/>
                            <Button x:Name="WuRefreshButton" Style="{StaticResource SecondaryButton}"
                                    Content="{l:Loc tools.wu.refresh}" Margin="10,0,0,0" Click="WuRefreshButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MilestonePSTools -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Loc tools.pstools.title}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{l:Loc tools.pstools.desc}"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{l:Loc dash.openPstools}"
                                HorizontalAlignment="Left" Click="OpenPSToolsButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Log folder -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Loc tools.logfolder.title}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{l:Loc tools.logfolder.desc}"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="{l:Loc tools.logfolder.open}"
                                HorizontalAlignment="Left" Click="OpenLogFolderButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- System report -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Loc tools.report.title}" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{l:Loc tools.report.desc}"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ReportButton" Style="{StaticResource PrimaryButton}"
                                    Content="{l:Loc tools.report.generate}" Click="ReportButton_Click"/>
                            <TextBlock x:Name="ReportStatusText" Text="" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                       Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
