<UserControl x:Class="XProtectPrepareWin.UI.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,24" MaxWidth="1500">
            <TextBlock Text="System" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Hardware, operating system and drive details for this machine."
                       Style="{StaticResource PageSub}" Margin="0,6,0,18"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="System details" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Operating system" Style="{StaticResource MutedText}" Margin="0,4"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OsText" Text="Detecting…" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" Style="{StaticResource MutedText}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VersionText" Text="…" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="CPU" Style="{StaticResource MutedText}" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CpuText" Text="…" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Memory" Style="{StaticResource MutedText}" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RamText" Text="…" FontSize="13" Margin="0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Domain" Style="{StaticResource MutedText}" Margin="0,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DomainText" Text="…" FontSize="13" Margin="0,4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="XProtect" Style="{StaticResource MutedText}" Margin="0,4"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="XProtectText" Text="…" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Drives" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                    <!-- Header -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Drive" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Label" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Size" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Free" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Block size" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="Indexing" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="" Style="{StaticResource MutedText}"/>
                    </Grid>

                    <ItemsControl x:Name="DrivesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0"
                                        Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Letter}" FontSize="13"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding FreeText}" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="4" Background="{Binding BlockBg}" CornerRadius="9"
                                                Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BlockText}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding BlockBrush}"/>
                                        </Border>
                                        <Border Grid.Column="5" Background="{Binding IndexBg}" CornerRadius="9"
                                                Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IndexText}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding IndexBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="6" Text="{Binding SystemTag}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="DrivesEmptyText" Text="Detecting drives…" Style="{StaticResource MutedText}"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
