<Window x:Class="XProtectPrepareWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XProtect Prepare Win"
        Icon="/Assets/wolf-smooth.png"
        Width="1300" Height="840" MinWidth="1150" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="{StaticResource BgBrush}">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/wolf-smooth.png" Width="22" Height="22"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="XProtect Prepare Win" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinButton" Style="{StaticResource TitleBarButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Content="&#xE921;" Click="MinButton_Click"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Content="&#xE922;" Click="MaxButton_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Content="&#xE8BB;" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Body: sidebar + page host -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,20">
                            <Image Source="/Assets/manvarg-white.png" Width="100"
                                   HorizontalAlignment="Left" Opacity="0.75"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Margin="0,10,0,0" FontSize="10.5" LineHeight="15"
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       Text="Prepares XProtect by best practice&#x0a;by an ex Milestone Solution Engineer.&#x0a;Not affiliated with Milestone Systems."/>
                        </StackPanel>
                        <StackPanel Margin="0,16,0,0">
                            <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE80F;" Content="Dashboard" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE770;" Content="System" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavPreparation" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE9D5;" Content="Preparation" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavTools" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE90F;" Content="Tools" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavLogs" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE7C3;" Content="Logs" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE713;" Content="Settings" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Tag="&#xE946;" Content="About" Checked="Nav_Checked"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ContentControl x:Name="PageHost" Grid.Column="1" Focusable="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
