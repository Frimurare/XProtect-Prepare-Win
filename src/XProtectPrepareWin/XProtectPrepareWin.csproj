<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>XProtectPrepareWin</AssemblyName>
    <RootNamespace>XProtectPrepareWin</RootNamespace>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.3</Version>
    <Company>Manvarg AB</Company>
    <Authors>Ulf Holmström</Authors>
    <Product>XProtect Prepare Win</Product>
    <Copyright>© Ulf Holmström, Manvarg AB, Sweden</Copyright>
    <Description>Prepares Windows for Milestone XProtect installations by best practice. Not affiliated with Milestone Systems A/S.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF resources (images etc.). The bundled OpenSSH MSI is handled below as
         an embedded resource instead, so exclude it from the WPF resource glob. -->
    <Resource Include="Assets\**\*" Exclude="Assets\app.ico;Assets\OpenSSH\**\*" />
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The official OpenSSH-Win64 MSI, embedded so the optional SSH task can
         install it locally with no Windows Update / internet dependency. -->
    <EmbeddedResource Include="Assets\OpenSSH\OpenSSH-Win64.msi" LogicalName="OpenSSH-Win64.msi" />
  </ItemGroup>

</Project>
