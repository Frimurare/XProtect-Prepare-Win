<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>XProtectPrepareWin</AssemblyName>
    <RootNamespace>XProtectPrepareWin</RootNamespace>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Company>Manvarg AB</Company>
    <Authors>Ulf Holmström</Authors>
    <Product>XProtect Prepare Win</Product>
    <Copyright>© Ulf Holmström, Manvarg AB, Sweden</Copyright>
    <Description>Prepares Windows for Milestone XProtect installations — by best practice, from an ex Milestone Solution Engineer. Not affiliated with Milestone Systems A/S.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" Exclude="Assets\app.ico" />
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
